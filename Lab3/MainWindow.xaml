<Window x:Class="Lab3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab3"
        mc:Ignorable="d"
        Title="Система оренди нерухомості" Height="726" Width="859" 
        Foreground="#FF252D35" Background="#FFD0F1B8" FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="3"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,5,0,5"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--Блок створення договору оренди -->
        <GroupBox Header="Новий договір оренди" Grid.Row="0">
            <StackPanel Orientation="Vertical" Margin="5">
                <ComboBox x:Name="PropertyTypeComboBox" Width="220" HorizontalAlignment="Left" 
                          SelectionChanged="PropertyTypeComboBox_SelectionChanged">
                    <ComboBoxItem Content="Квартира" IsSelected="True"/>
                    <ComboBoxItem Content="Будинок"/>
                </ComboBox>
                <Label Content="Тип нерухомості:"/>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Загальні поля для будь-якої нерухомості -->
                    <Label Grid.Row="0" Grid.Column="0" Content="Адреса:"/>
                    <TextBox x:Name="AddressTextBox" Grid.Row="0" Grid.Column="1"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="Вартість за місяць (грн):"/>
                    <TextBox x:Name="MonthlyPriceTextBox" Grid.Row="1" Grid.Column="1"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="Загальна площа (м²):"/>
                    <TextBox x:Name="TotalAreaTextBox" Grid.Row="2" Grid.Column="1"/>

                    <!-- Специфічне поле: Квартира -->
                    <StackPanel x:Name="ApartmentFields" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
                        <Label Content="Кількість кімнат:" Width="160"/>
                        <TextBox x:Name="RoomsCountTextBox" Width="100"/>
                    </StackPanel>

                    <!-- Специфічне поле: Будинок -->
                    <StackPanel x:Name="HouseFields" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Visibility="Collapsed">
                        <Label Content="Наявність саду:" Width="160"/>
                        <CheckBox x:Name="HasGardenCheckBox" Content="Є присадибна ділянка / сад" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="AddAndPayButton" Content="Оформити та оплатити" Click="AddAndPayButton_Click" Margin="0,10,10,0"/>
                    <Button x:Name="TerminateButton" Content="Розірвати останній договір" Click="TerminateButton_Click" Background="#E53935" Margin="0,10,0,0"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Список протоколів та операцій -->
        <GroupBox Header="Журнал договорів та оплат" Grid.Row="1">
            <ListBox x:Name="RentalsListBox"/>
        </GroupBox>

        <!-- Блок підсумкової аналітики  -->
        <GroupBox Header="Аналітика оренди" Grid.Row="2">
            <StackPanel Orientation="Horizontal" Margin="5" HorizontalAlignment="Center">
                <TextBlock Text="Середня вартість оренди за 1 м²: " FontWeight="Bold" FontSize="14"/>
                <TextBlock x:Name="AveragePricePerMeterTextBlock" Text="0.00 грн/м²" FontSize="14" Foreground="#1B5E20"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>
